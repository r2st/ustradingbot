# ── Anthropic (Claude AI veto layer) ──────────────────────────────────────────
ANTHROPIC_API_KEY=your_api_key_here

# ── Telegram Notifications ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Interactive Brokers Gateway / TWS ────────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=

# ── Trading Mode ─────────────────────────────────────────────────────────────
# paper | live  (also inferred from IBKR_PORT: 7497=paper, 7496=live)
TRADING_MODE=paper

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
