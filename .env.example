# ── AI veto layer (OpenRouter) ───────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys. Free models (e.g. the default
# openai/gpt-oss-20b:free) cost $0. The key is never hard-coded in source.
# Provide it EITHER here OR as a loose file at keys/openrouter-key (gitignored).
# Leaving the placeholder below unedited is treated as "unset" — it will not be
# sent to OpenRouter (that only ever 401s); the keys/ file is used instead.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-oss-20b:free
AI_VETO_ENABLED=True
AI_CACHE_TTL_HOURS=4
AI_EARNINGS_BLACKOUT_DAYS=14
# The veto fails CLOSED on anything it can't trust as an answer (rejected key,
# bad request, empty/unparseable output). It does NOT fail closed when every
# provider is merely unavailable (all rate-limited, 5xx, or timed out) — a 429
# is not a risk verdict, and treating it as one halted trading for the rest of
# the scan. Set to False to restore fail-closed-on-everything.
AI_FAIL_OPEN_ON_PROVIDER_ERROR=True

# ── LLM fallback providers (OpenRouter → Gemini → Groq) ─────────────────────
# Every LLM consumer (veto, trade reflection, dashboard commentary) goes through
# ai/llm_router.py. When OpenRouter is rate-limited or down the chain falls back
# to Gemini, then Groq — all three speak the OpenAI /chat/completions dialect.
# A provider with no key is skipped. Keys can live here or as loose gitignored
# files at keys/gemini_api_key and keys/groq_api_key.
#
# Use gemini-flash-latest: the pinned gemini-2.0-flash id has zero free-tier
# quota and 429s on the first call.
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Set False to try OpenRouter only (quickest way to isolate a bad fallback).
LLM_FALLBACK_ENABLED=True
# After this many consecutive failures a provider is skipped for the cooldown
# instead of costing a full timeout on every call.
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SECONDS=300
# Backoff applied when a 429 carries no (or an implausible) Retry-After header.
LLM_DEFAULT_RETRY_AFTER_SECONDS=60
LLM_MAX_RETRY_AFTER_SECONDS=3600

# ── Broker ───────────────────────────────────────────────────────────────────
# paper = built-in simulated broker (default, no gateway needed, headless-safe)
# ibkr  = Interactive Brokers via ib_insync (needs a running TWS/Gateway)
BROKER=paper

# ── Paper-broker fill realism (also used by the backtester) ──────────────────
# Slippage in basis points (1 bp = 0.01%): entries fill above, stops below.
# Commission is charged per share on both entry and exit; paper P&L is net.
PAPER_SLIPPAGE_BPS=5.0
PAPER_COMMISSION_PER_SHARE=0.005

# ── Market-data provider ─────────────────────────────────────────────────────
# Choose the market-data backend (also switchable live from the dashboard):
#   yfinance = free Yahoo Finance (default, no key).
#   alpaca   = Alpaca REST + websocket streaming (needs `pip install .[alpaca]`
#              and the ALPACA_* keys below; get keys at https://app.alpaca.markets).
#   polygon  = Polygon.io REST (needs POLYGON_API_KEY; get one at https://polygon.io).
# If Alpaca keys are present, set MARKET_DATA_PROVIDER=alpaca to use them by
# default (the dashboard does this automatically when you save Alpaca keys).
MARKET_DATA_PROVIDER=yfinance
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex
POLYGON_API_KEY=

# ── Data cache + fetch retry ─────────────────────────────────────────────────
# Thread-safe TTL cache collapses the redundant per-cycle fetches; failures are
# retried with exponential backoff.
DATA_CACHE_ENABLED=True
PRICE_CACHE_TTL_SECONDS=300
OHLCV_CACHE_TTL_SECONDS=3600
FETCH_MAX_RETRIES=3
FETCH_RETRY_BASE_DELAY_SECONDS=0.5
FETCH_RETRY_MAX_DELAY_SECONDS=8.0

# ── Realtime exits (only meaningful with a streaming provider like alpaca) ───
# Between full scan cycles the engine wakes this often to run exit management.
ENABLE_REALTIME_EXITS=True
REALTIME_EXIT_POLL_SECONDS=30

# ── Interactive Brokers Gateway / TWS (only used when BROKER=ibkr) ────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=

# ── Telegram notifications (optional; leave blank to disable) ─────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dashboard (FastAPI, default port 8501) ───────────────────────────────────
# The dashboard is protected by HTTP Basic Auth. Set a strong password before
# exposing it. With auth enabled and no password set, the app fails closed
# (returns HTTP 500) rather than serving config without credentials.
# Set DASHBOARD_AUTH_ENABLED=False only for trusted local development.
DASHBOARD_AUTH_ENABLED=True
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me_to_a_strong_password
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501

# ── Broker reconnection (exponential backoff) ────────────────────────────────
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_BASE_DELAY_SECONDS=2.0
RECONNECT_MAX_DELAY_SECONDS=60.0

# ── Data persistence ─────────────────────────────────────────────────────────
DATA_DIR=data_store

# ── Dynamic stop-loss (trailing / breakeven / time-based / volatility) ───────
# All stops only ever ratchet UP; the highest (most protective) candidate wins.
ENABLE_TRAILING_STOP=True
TRAIL_ATR_MULTIPLIER=2.0
TRAIL_ACTIVATION_PROFIT_PCT=0.05
ENABLE_BREAKEVEN_STOP=True
BREAKEVEN_TRIGGER_R=1.0
BREAKEVEN_BUFFER_PCT=0.001
ENABLE_TIME_STOP_TIGHTENING=True
TIME_STOP_TIGHTEN_DAYS=5
TIME_STOP_TIGHTEN_ATR_MULTIPLIER=1.0
TIME_STOP_STAGNANT_PROFIT_PCT=0.02
ENABLE_VOLATILITY_STOPS=True
STOP_ATR_PERIOD=14
# Per-strategy overrides as JSON, e.g.
# STOP_OVERRIDES_BY_STRATEGY={"mean_reversion": {"TRAIL_ATR_MULTIPLIER": 1.5}}

# ── Advanced order execution ─────────────────────────────────────────────────
LIMIT_ORDER_EXPIRY_HOURS=4.0
ENABLE_SCALE_IN=False
SCALE_IN_TRANCHES=3
SCALE_IN_STEP_PCT=0.01
ENABLE_PARTIAL_TAKE=True
PARTIAL_TAKE_PCT=0.5
PARTIAL_TAKE_TARGET_R=1.0
ENABLE_MOC_ENTRIES=False

# ── Mode switching (paper ⇄ live) ────────────────────────────────────────────
# The dashboard toggle flips BROKER/IBKR_PORT; going live needs the admin
# (DASHBOARD_PASSWORD) password.  Set False to disable switching entirely.
ALLOW_MODE_SWITCH=True

# ── Email alerts (SMTP; optional) ────────────────────────────────────────────
EMAIL_ALERTS_ENABLED=False
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
EMAIL_FROM=
EMAIL_TO=

# ── Alert routing & thresholds ───────────────────────────────────────────────
ALERT_ON_ENTRY=True
ALERT_ON_EXIT=True
ALERT_ON_MODE_SWITCH=True
ALERT_DRAWDOWN_PCT=0.05
ALERT_DAILY_LOSS_PCT=0.01

# ── Multi-timeframe analysis (confirm daily signals with weekly trend) ───────
ENABLE_MULTI_TIMEFRAME=True
WEEKLY_TREND_EMA_PERIOD=30
MTF_REQUIRE_WEEKLY_UPTREND=True

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ═════════════════════════════════════════════════════════════════════════════
# NEW FEATURES (watchlist, news, regime, automation, multi-user, REST API …)
# ═════════════════════════════════════════════════════════════════════════════

# ── Watchlist management (feature 1) ─────────────────────────────────────────
# Scan the user-managed lists in DATA_DIR/watchlists.json instead of the
# hard-coded universe. Falls back to the universe when the file is empty.
USE_WATCHLIST_FILE=True

# ── News sentiment filter (feature 4) — Finnhub free tier ────────────────────
NEWS_SENTIMENT_ENABLED=False
FINNHUB_API_KEY=
NEWS_LOOKBACK_DAYS=3
NEWS_SENTIMENT_MIN_SCORE=-0.15
NEWS_MIN_ARTICLES=2
NEWS_CACHE_TTL_MINUTES=30

# ── Market regime detection (feature 13) ─────────────────────────────────────
REGIME_DETECTION_ENABLED=True
REGIME_BENCHMARK=SPY
REGIME_FAST_MA=50
REGIME_SLOW_MA=200
REGIME_VOL_WINDOW=20
REGIME_HIGH_VOL_PCT=0.018

# ── Strategy auto-tuning (feature 12) ────────────────────────────────────────
AUTOTUNE_ENABLED=False
AUTOTUNE_LOOKBACK_TRADES=30
AUTOTUNE_MIN_TRADES=15
AUTOTUNE_MAX_GRADE_ADJUST=0.08

# ── Scheduler + automated reports (features 10, 11) ──────────────────────────
SCHEDULER_ENABLED=False
PNL_REPORT_ENABLED=False
PNL_REPORT_DAILY_TIME=17:00
PNL_REPORT_WEEKLY_ENABLED=True
PNL_REPORT_WEEKLY_DAY=FRI
SCHEDULED_BACKTEST_ENABLED=False
SCHEDULED_BACKTEST_TIME=02:00
SCHEDULED_BACKTEST_LOOKBACK_DAYS=180

# ── Pre-market scanner (feature 14) ──────────────────────────────────────────
PREMARKET_GAP_PCT=0.02
PREMARKET_VOLUME_RATIO=1.5

# ── Monte Carlo projection (feature 8) ───────────────────────────────────────
MONTE_CARLO_RUNS=1000
MONTE_CARLO_HORIZON=50

# ── Multi-user support (feature 16) ──────────────────────────────────────────
MULTI_USER_ENABLED=False

# ── REST API (feature 19) — API keys minted from the dashboard ───────────────
REST_API_ENABLED=True

# ═══════════════════════════════════════════════════════════════════════════
# Earnings, ETFs, Extended-Hours & Ratings (FEATURE_SPEC_EARNINGS_ETF_AH.md)
# ═══════════════════════════════════════════════════════════════════════════

# ── Feature 1: Earnings filter + results ─────────────────────────────────────
EARNINGS_FILTER_MODE=off            # off | flag | block
EARNINGS_BLOCK_DAYS=2
EARNINGS_RESULTS_ENABLED=False
EARNINGS_RESULTS_CACHE_TTL_MINUTES=360
FMP_API_KEY=                        # optional Financial Modeling Prep key (shared F1/F2/F5)

# ── Feature 2: Daily earnings tracker ────────────────────────────────────────
CONTAGION_SURPRISE_THRESHOLD=5.0
EARNINGS_HISTORY_ENABLED=True

# ── Feature 3: ETF support + sector rotation ─────────────────────────────────
ETF_RISK_MODIFIER=1.3
ETF_NOTIONAL_CAP_PCT=0.15
STOCK_NOTIONAL_CAP_PCT=0.10
MIN_ATR_PCT_ETF=0.008
SECTOR_ROTATION_ENABLED=False
SECTOR_ROTATION_TOP_N=3
SECTOR_ROTATION_LOOKBACK_DAYS=63

# ── Feature 4: Extended-hours data + overnight-gap filter ────────────────────
EXTENDED_HOURS_ENABLED=False
EXT_HOURS_PROVIDER=auto             # auto | ibkr | alpaca
EXT_HOURS_CACHE_TTL_SECONDS=60
GAP_FILTER_ENABLED=False
GAP_DOWN_SKIP_PCT=-0.05
GAP_UP_CHASE_PCT=0.08
GAP_RESIZE_PCT=0.03
GAP_RESIZE_MODIFIER=0.5
EXT_UNUSUAL_VOLUME_RATIO=3.0

# ── Feature 5: Third-party ratings filter (Finnhub default; SA not shipped) ──
RATINGS_FILTER_ENABLED=False
RATINGS_PROVIDER=finnhub            # finnhub | fmp
RATINGS_MIN=hold                    # strong_sell | sell | hold | buy | strong_buy
RATINGS_FAIL_OPEN=True
RATINGS_CACHE_TTL_MINUTES=720

# ── Memory & learning layer (F1 + F2) — see docs/memory-learning-layer.md ────
# F1 · AI Trade Reflection: after a close an OpenRouter model writes one lesson
# to data_store/learnings.jsonl; a guard applies binding lessons before entries.
# Needs a working OPENROUTER_API_KEY to write lessons (fail-open without one).
LEARNINGS_ENABLED=True
LEARNINGS_MODEL=openai/gpt-oss-20b:free
LEARNINGS_MAX_AGE_DAYS=90           # lessons expire after 90 days
LEARNINGS_MAX_RELEVANT=5            # max lessons weighed per entry
LEARNINGS_MIN_TRADES_FOR_PATTERN=3  # similar trades needed for a lesson to bind
LEARNINGS_MIN_CONFIDENCE=0.6        # below this a lesson is advisory (observe)
LEARNINGS_MAX_TOKENS=400            # reflection completion cap
# F2 · Similar-Setup Guard: before an entry, query trades.csv for similar setups
# and demote/skip on a poor win rate. Pure/local — no API key required.
SIMILAR_SETUP_ENABLED=True
SIMILAR_SETUP_LOOKBACK_DAYS=90
SIMILAR_SETUP_MIN_MATCHES=5         # matches required before the guard acts
SIMILAR_SETUP_RSI_TOLERANCE=10.0    # ±10 RSI points for "similar"
SIMILAR_SETUP_VOL_TOLERANCE=0.5     # ±0.5 volume ratio for "similar"
SIMILAR_SETUP_MIN_WIN_RATE=0.35     # below this → demote to grade-A-only
SIMILAR_SETUP_BLOCK_WIN_RATE=0.15   # below this (solid sample) → hard skip

# ── Tiered symbol universe (S&P 500 / NASDAQ-100) — see docs/tiered-universe.md ─
# Tier 1 (watchlist ∪ ETFs ∪ promoted) every cycle; Tier 2 (scan pool) daily;
# Tier 3 (full index universe) weekly. Uses data_store/universe.db when present,
# else the static lists in config/index_membership.py.
TIERED_SCANNING_ENABLED=True
TIER1_WORKERS=4
TIER2_ENABLED=True
TIER2_WORKERS=8
TIER2_SCAN_POOL_SIZE=250            # top-N S&P 500 by volume × market cap
TIER2_INTERVAL_MINUTES=30           # legacy sector-rotation throttle (unused by index tiers)
TIER3_ENABLED=True
TIER3_WORKERS=16
TIER3_PRESCREEN_PRICE_CHANGE_PCT=0.03   # 3% daily move qualifies for full scan
TIER3_PRESCREEN_VOLUME_RATIO=2.0        # 2× avg volume qualifies for full scan
PROMOTION_TTL_HOURS=72.0            # Tier 2/3 signal keeps a symbol in Tier 1 this long (≤0 = never expire)
BATCH_DOWNLOAD_SIZE=50
